# ==========================================
# EDITH Environment Configuration
# ==========================================

# Core Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security & JWT Tokens
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./edith.db
# DATABASE_URL=postgresql+asyncpg://edith_user:edith_password@localhost:5432/edith_db

# AI Provider Settings ("ollama", "openai", "gemini")
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Windows Agent Pairing Configuration
DEFAULT_PAIRING_EXPIRY_MINUTES=5
AGENT_HEARTBEAT_INTERVAL_SECONDS=30
